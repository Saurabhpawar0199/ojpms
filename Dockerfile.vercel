# ---- build ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B clean package -DskipTests

# ---- run (Vercel injects PORT; application.properties reads it) ----
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/ojpms-0.0.1-SNAPSHOT.war app.war
ENTRYPOINT ["java", "-XX:+UseSerialGC", "-XX:TieredStopAtLevel=1", "-XX:MaxRAMPercentage=75", "-jar", "app.war"]
